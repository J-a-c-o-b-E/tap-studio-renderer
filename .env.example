# Copy to .env (git-ignored) for local runs of the agent: node agent/run.mjs --job examples/jobs/motion_vsl.json
# The same names are the environment variables of the Trigger.dev task.
ANTHROPIC_API_KEY=
VIDLAB_API_KEY=
# Bunny Storage zone password, sent as the AccessKey header on uploads to storage.bunnycdn.com
BUNNY_STORAGE_API_KEY=
# Default HMAC secret for progress and result webhooks (a job can carry its own)
WEBHOOK_SECRET=
# Optional
AGENT_MODEL=claude-fable-5-2
TRIGGER_PROJECT_REF=
